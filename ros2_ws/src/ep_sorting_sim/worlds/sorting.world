    </model>
    <model name="overhead_camera">
      <static>true</static>
      <pose>0 0 2.1 0 0 0</pose>
      <link name="camera">
        <sensor name="overhead" type="camera">
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <pose>0 0 0 0 1.5707963 0</pose>
          <camera>
            <horizontal_fov>1.4</horizontal_fov>
            <image>
              <width>960</width>
              <height>720</height>
              <format>B8G8R8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>5</far>
            </clip>
          </camera>
          <plugin filename="libgazebo_ros_camera.so" name="overhead_ros">
            <ros>
              <namespace>/sim</namespace>
            </ros>
            <camera_name>overhead</camera_name>
            <frame_name>sim_overhead</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
